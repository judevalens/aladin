# Aladin PROD config — TEMPLATE. Copy to backend_v2/.env.prod (gitignored) and
# fill in. `make prod-env` generates a filled .env.prod for you (random infra
# passwords + OpenAI/Tavily copied from backend_v2/.env).
#
# Hostnames here are docker-compose SERVICE names (postgres/redis/neo4j/
# blocknote), resolved on the internal network — NOT localhost. Backups/psql
# from the host use the mapped host ports instead (see PROD.md).

# --- Postgres (canonical store) ---------------------------------------------
POSTGRES_PASSWORD=change-me-strong
DATABASE_URL=postgres://aladin:change-me-strong@postgres:5432/aladin?sslmode=disable

# --- Redis (worker queue/cache; only used when the worker profile is on) ----
REDIS_URL=redis://redis:6379/0

# --- Neo4j (graph lens; only the worker writes it) --------------------------
NEO4J_PASSWORD=change-me-strong
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASS=change-me-strong

# --- OpenAI (REQUIRED by the worker; the copilot no longer uses it) ---------
OPENAI_API_KEY=sk-...

# --- Copilot agent sidecar (profile `copilot`) ------------------------------
# The copilot runs on the Claude Agent SDK in services/copilot-agent.
ANTHROPIC_API_KEY=sk-ant-...
# Shared secret between the Go API and the sidecar. Empty fails closed.
COPILOT_AGENT_SHARED_SECRET=change-me-agent-secret
# Model override (default claude-opus-4-7).
#COPILOT_MODEL=claude-opus-5

# --- Optional integrations --------------------------------------------------
TAVILY_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=

# --- Collab sidecar ---------------------------------------------------------
# Shared secret guarding the MCP<->converter admin bridge. mcp and blocknote
# must agree. Empty string fails the bridge closed.
BLOCKNOTE_ADMIN_SHARED_SECRET=change-me-admin-secret

# --- Runtime ----------------------------------------------------------------
LOG_LEVEL=info
WORKER_CONCURRENCY=16
# No public tunnel in prod: Nango/Gmail/GitHub OAuth ingestion is off by default.
NGROK_AUTOSTART=0
