          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "op": {
          "enum": [
            "insert",
            "update"
          ]
        },
        "record": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
