{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "where": {
      "$ref": "#/$defs/predicate"
    },
    "orderBy": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "pattern": "^(?:/(?:[^~/]|~[01])*)+$",
            "maxLength": 1024
          },
          "direction": {
            "enum": [
              "asc",
              "desc"
            ]
          }
        },
        "required": [
          "field",
          "direction"
        ],
        "additionalProperties": false
      },
      "maxItems": 32
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 4096
    }
  },
  "required": [],
  "additionalProperties": false,
  "$defs": {
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "and": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/predicate"
              },
              "minItems": 1,
              "maxItems": 32
            }
          },
          "required": [
            "and"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "or": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/predicate"
              },
              "minItems": 1,
              "maxItems": 32
            }
          },
          "required": [
            "or"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~[01])*)+$",
              "maxLength": 1024
            },
            "op": {
              "enum": [
                "eq",
                "gt",
                "gte",
                "lt",
                "lte"
              ]
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "field",
            "op",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~[01])*)+$",
              "maxLength": 1024
            },
            "op": {
              "const": "in"
            },
            "value": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "minItems": 1,
              "maxItems": 100
            }
          },
          "required": [
            "field",
            "op",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~[01])*)+$",
              "maxLength": 1024
            },
            "op": {
              "const": "exists"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "field",
            "op",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
