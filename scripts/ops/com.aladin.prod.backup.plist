<?xml version="1.0" encoding="UTF-8"?>
<!--
  Daily Aladin PROD Postgres backup (macOS launchd LaunchAgent).

  Install (copies the script out of ~/Documents, then loads the agent):
    make prod-backup-install

  Run once now (test):
    launchctl kickstart -k gui/$UID/com.aladin.prod.backup

  Uninstall:
    launchctl bootout gui/$UID/com.aladin.prod.backup

  WHY THE SCRIPT IS NOT RUN FROM THE REPO: ~/Documents is a TCC-protected
  directory. A launchd agent has no Full Disk Access, so pointing
  ProgramArguments at scripts/ops/backup_prod.sh in the repo fails with
  "Operation not permitted" (exit 126) — the job runs nightly and silently
  never produces a dump. `make prod-backup-install` copies the script to
  ~/Library/Application Support/aladin/ (not TCC-protected) and points this
  plist there. Re-run that target after editing backup_prod.sh.

  Runs at 03:00 daily. If the Mac is asleep at 03:00, launchd runs it at wake.
  Logs -> ~/aladin-backups/backup.log.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aladin.prod.backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/judepaulemon/Library/Application Support/aladin/backup_prod.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/judepaulemon/Library/Application Support/aladin</string>

    <!-- launchd's PATH is minimal; add Docker Desktop's CLI location. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/judepaulemon</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/judepaulemon/aladin-backups/backup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/judepaulemon/aladin-backups/backup.log</string>
</dict>
</plist>
