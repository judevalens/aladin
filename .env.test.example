# Sandbox env for agent/automated testing against the isolated stack
# (docker-compose.test.yml). Copy to `.env.test` and `source` it, or rely on the
# `make test-go` target which exports these inline.
#
#   cp .env.test.example .env.test
#   set -a && . ./.env.test && set +a   # export all for a manual run
#
# These point at the SANDBOX ports (5444 / 7688 / 6380), never the dev stack.

# --- Postgres (sandbox) ---
# Used by `go test` destructive DB tests. The dbtest guard REQUIRES this to be
# set AND to differ from DATABASE_URL, so leave DATABASE_URL unset when running
# tests (or set it to the dev DB — just never equal to this).
TEST_DATABASE_URL=postgres://aladin:password@localhost:5444/aladin

# For running the API/worker against the sandbox (NOT while running go test —
# keep DATABASE_URL != TEST_DATABASE_URL):
# DATABASE_URL=postgres://aladin:password@localhost:5444/aladin

# --- Neo4j (sandbox) ---
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASS=password

# --- Redis (sandbox) ---
REDIS_URL=localhost:6380

# --- External API keys (worker only; leave blank if not exercising the worker) ---
OPENAI_API_KEY=
TAVILY_API_KEY=
