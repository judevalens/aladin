TEAM_ID=

PRODUCT_NAME=anchor

// The flavour. Two ids = two apps that coexist on one iPad, each with its own local
// database and login, so dev churn can't touch prod state. These defaults are the DEV
// flavour, which is what an Xcode run should be — `make prod-ipad` overrides all three
// on the xcodebuild command line (which outranks both this file and the target).
ALADIN_BUNDLE_SUFFIX=.dev
ALADIN_DISPLAY_NAME=Anchor Dev
ALADIN_APPICON=AppIconDev

PRODUCT_BUNDLE_IDENTIFIER=dawn.system.anchor.anchor$(TEAM_ID)$(ALADIN_BUNDLE_SUFFIX)
INFOPLIST_KEY_CFBundleDisplayName=$(ALADIN_DISPLAY_NAME)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// SQLDelight's iOS driver (co.touchlab:sqliter) calls the system SQLite, so the app must
// link libsqlite3 — without this the link fails with undefined _sqlite3_* symbols.
OTHER_LDFLAGS = $(inherited) -lsqlite3